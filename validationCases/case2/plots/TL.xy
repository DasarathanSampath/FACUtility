#!/usr/bin/gnuplot    
reset

set term pngcairo dashed font "Times,40" size 1920,1080

set style line 1 lt 1 lw 4 linecolor rgb "#000000"
set style line 2 lt 1 lw 4 linecolor rgb "#00008B"

set output 'TL.png'

set grid
set xlabel "Distance (mm)" font "Times Bold,40"

set ylabel "T_{L} (mm/10,000 hours)" font "Times Bold,40"

set key outside center top horizontal

set title "Thickness Loss (T_{L})" font "Times Bold,50"

#################
#Stats
#################
stats "postProcessing/FACUtility/4000/FAC_downstream.dat" every ::0::1473 using 7 nooutput name 'TL'

set ytics add ('' (TL_mean))
set rmargin 9
set label 1 at 22.2,(TL_mean+TL_mean*1.2) sprintf('%.4f', TL_mean)
set arrow from 20,(TL_mean) rto 2,(TL_mean*1.2)

set term pngcairo enhanced linewidth 2

plot "postProcessing/FACUtility/4000/FAC_downstream.dat" every ::0::1473 using (($1-0.253)*1000):7 title 'T_{L}' w l ls 1, \
     "postProcessing/FACUtility/4000/FAC_downstream.dat" every ::0::1473 using (($1-0.253)*1000):(TL_mean) title 'T_{L Mean}' w l ls 2