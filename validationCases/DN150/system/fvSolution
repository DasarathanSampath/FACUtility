FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver           GAMG;
        tolerance        1e-7;
        relTol           1e-7;

        smoother         DICGaussSeidel;

    }

    "(U|h|k|epsilon|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          1e-7;
    }
}

PIMPLE
{
    momentumPredictor true;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;

    residualControl
    {
        p_rgh           1e-7;
        U               1e-7;
        h               1e-7;

        // possibly check turbulence fields
        "(k|epsilon|omega)" 1e-7;
    }
}

relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           0.7;
    }
    equations
    {
        U               0.3;
        h               0.3;
        "(k|epsilon|omega)" 0.7;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 20;
    nCorrectors              20;
    //PhiRefPoint       (0 0.005 0.00005);
    //PhiRefValue       0;
}


