FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
    div(phi,U)      bounded Gauss upwind;//upwind;//linearUpwind grad(U);
    div(phi,k)      bounded Gauss upwind;//upwind;//linearUpwind grad(k);
    div(phi,epsilon) bounded Gauss upwind;//linearUpwind grad(epsilon);
    div(phi,omega)  bounded Gauss upwind;//linearUpwind grad(U);
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
    div(nonlinearStress) Gauss linear;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phi,K)      bounded Gauss upwind;//upwind;//linearUpwind grad(K);
    div(phi,h)      bounded Gauss upwind;//upwind;//linearUpwind grad(h);
    div(phid,p)     bounded Gauss upwind;//upwind;//linearUpwind grad(p);
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}


