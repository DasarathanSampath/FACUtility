FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 4.1;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.00035; //a good estimation is 0.07*characteristic_length
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    upperWall
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    "(upstream|downstream|obstructionTop|obstructionLeft|obstructionRight)"
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    contractionWalls
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    frontWall
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    backWall
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
}


