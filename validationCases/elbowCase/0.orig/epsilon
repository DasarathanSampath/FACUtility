FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.0129;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.0107; //a good estimation is 0.07*characteristic_length
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
    }

    "(walls|elbow)"
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
}

