FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

viscosityModel  constant;
nu                      nu [0 2 -1 0 0 0 0] 1.99e-7; //m2/s
fluidDensity            fluidDensity [1 -3 0 0 0 0 0] 916.7; //kg/m3
meanVelocity            meanVelocity [0 1 -1 0 0 0 0] 3; //m/s
characteristicLength    characteristicLength [0 1 0 0 0 0 0] 0.152; //m
ferrousIronDiffusivity  ferrousIronDiffusivity [0 2 -1 0 0 0 0] 3.3e-8; //m2/s
ironSolubility          ironSolubility [0 0 0 0 0 0 0] 1.92e-9; //1.18e-8; //in L/L
chromiumEffectFactor    chromiumEffectFactor [0 0 0 0 0 0 0] 0.9;
corrosionHours          corrosionHours [0 0 1 0 0 0 0] 10000;//10 thousand hours
corrosionTemperature    corrosionTemperature [0 0 0 1 0 0 0] 423.15;//in Kelvin
inputSolutionMolality   inputSolutionMolality [0 0 0 0 0 0 0] 9e-6;//Molality of Cl- or negative molality of K+ from input solution

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectFluid;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       18;//in mol/g
    }
    equationOfState
    {
        rho0             916.7;//@150° C in kg/m3
        R               4181;
    }
    thermodynamics
    {
        Cp              4181;
        Hf              0;
    }
    transport
    {
        mu              1.82e-4;//@150° C in kg/m-s
        Pr              6.62;
    }
}


